@page "{*_}"
@using System.ComponentModel.DataAnnotations
@using Moryx.Modules
@using Moryx.Material.Web.Properties

@{
    ViewData["Title"] = Strings.Module_Title;
    ViewData["BaseRef"] = "Material";

    Layout = "_Layout";
}

@attribute [WebModule("Material", "engineering"),
            Display(ResourceType = typeof(Strings), Name = nameof(Strings.Module_Title), Description = nameof(Strings.Module_Description))]

@section Styles {
    <link rel="stylesheet" href="~/_content/Moryx.Material.Web/styles.css">
}

@section Scripts
{
    <script src="~/_content/Moryx.Material.Web/main.js" type="module"></script>
}

<app-root></app-root>
