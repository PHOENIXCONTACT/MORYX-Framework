{
  "$schema": "node_modules/ng-openapi-gen/ng-openapi-gen-schema.json",
  "input": "http://localhost:5001/swagger/v1/swagger.json",
  "output": "src/app/api",
  "ignoreUnusedModels": true,
  "includeTags": [
    "ResourceModification",
    "MaterialManagement"
  ],
  "defaultTag": "MaterialManagement",
  "module": true,
  "services": true,
  "apiService": "",
  "enumStyle": "pascal",
  "enumArray": false,
  "promises": false
}