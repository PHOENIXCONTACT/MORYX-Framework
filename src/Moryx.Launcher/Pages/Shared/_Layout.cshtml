@using System.Linq;
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Builder;
@using Microsoft.Extensions.Options;
@using Moryx.Identity
@using Moryx.Launcher
@inject IShellNavigator _navigator
@inject IOptionsMonitor<RequestLocalizationOptions> _localizationOptions
@inject IOptionsMonitor<MoryxIdentityOptions> _identityOptions
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    // Culture
    if (string.IsNullOrWhiteSpace(Context.Request.Cookies[".AspNetCore.Culture"]))
    {
        Context.Response.Cookies.Append(".AspNetCore.Culture", "c=en-US|uic=en-US");
    }

    var supportedCultures = _localizationOptions.CurrentValue.SupportedCultures?.Select(c => new CultureModel
    {
        Name = c.Name,
        DisplayName = c.DisplayName
    }) ?? [];

    // Modules
    var launcher = _navigator as ILauncher;
    var allModules = await _navigator.GetModuleItemsAsync(Context);
    var webModuleItems = allModules.OfType<WebModuleItem>().ToList();
    webModuleItems.ForEach(m => m.EventStream = Url.Content(m.EventStream));

    var externalModuleItems = allModules.OfType<ExternalModuleItem>().ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <meta name="moryx-path-base" content="@Url.Content("~/")">
    <base href="~/@ViewData["BaseRef"]">
    <link rel="stylesheet" href="~/_content/Moryx.Launcher/styles.css"/>
    <link rel="icon" type="image/x-icon" href="~/_content/Moryx.Launcher/assets/favicon.ico">
    @await RenderSectionAsync("Styles", false)
</head>
<body>
<moryx-launcher id="launcher">
    <div slot="app">
        @RenderBody()
    </div>
    @if (launcher != null && launcher.GetRegion(LauncherRegion.Top) is RegionItem topRegion)
    {
        <div slot="topRegion">
            @await Html.PartialAsync(topRegion.PartialView)
        </div>
    }
    @if (launcher != null && launcher.GetRegion(LauncherRegion.Right) is RegionItem rightRegion)
    {
        <div slot="rightRegion">

            @await Html.PartialAsync(rightRegion.PartialView)
        </div>
    }
</moryx-launcher>

<script src="~/_content/Moryx.Launcher/main.js" type="module"></script>

<script>
    @{
        var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
        jsonOptions.Converters.Add(new JsonStringEnumConverter());
    }
    const launcher = document.getElementById('launcher');

    launcher.supportedCultures = @Html.Raw(JsonSerializer.Serialize(supportedCultures, jsonOptions));
    launcher.webModuleItems = @Html.Raw(JsonSerializer.Serialize(webModuleItems, jsonOptions));
    launcher.externalModuleItems = @Html.Raw(JsonSerializer.Serialize(externalModuleItems, jsonOptions));
        @if (!string.IsNullOrEmpty(_identityOptions.CurrentValue.BaseAddress))
    {
        <text>launcher.authBaseAddress = '@_identityOptions.CurrentValue.BaseAddress';</text>
    }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
