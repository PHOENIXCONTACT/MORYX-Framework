@using System.Linq;
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Builder;
@using Microsoft.Extensions.Options;
@using Moryx.Launcher
@using Moryx.Modules
@inject IShellNavigator _navigator
@inject IOptionsMonitor<RequestLocalizationOptions> _localizationOptions
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    if (string.IsNullOrWhiteSpace(Context.Request.Cookies[".AspNetCore.Culture"]))
    {
        var culture = _localizationOptions.CurrentValue.DefaultRequestCulture.Culture;
        Context.Response.Cookies.Append(".AspNetCore.Culture", "c=en-US|uic=en-US");
    }

    var launcher = _navigator as ILauncher;

    var allModules = await _navigator.GetModuleItemsAsync(Context);
    var webModuleItems = allModules.OfType<WebModuleItem>().ToList();
    webModuleItems.ForEach(m => m.EventStream = Url.Content(m.EventStream));

    var externalModuleItems = allModules.OfType<ExternalModuleItem>().ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <base href="~/@ViewData["BaseRef"]">
    <link rel="stylesheet" href="~/_content/Moryx.Launcher/styles.css"/>
    <link rel="icon" type="image/x-icon" href="~/_content/Moryx.Launcher/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap"
        rel="stylesheet"
    />
    <link
        href="https://fonts.googleapis.com/icon?family=Material+Icons"
        rel="stylesheet"
    />
    @await RenderSectionAsync("Styles", false)
</head>
<body>
<moryx-launcher id="launcher">
    <div slot="app">
        @RenderBody()
    </div>
    <div slot="topRegion">
        <div style="width: 100%; background-color: red">
            TOP REGION
        </div>
        @if (launcher != null && launcher.GetRegion(LauncherRegion.Top) is RegionItem topRegion)
        {
            @await Html.PartialAsync(topRegion.PartialView)
        }
    </div>
    <div slot="rightRegion">
        @if (launcher != null && launcher.GetRegion(LauncherRegion.Right) is RegionItem rightRegion)
        {
            @await Html.PartialAsync(rightRegion.PartialView)
        }
    </div>
</moryx-launcher>

<script src="~/_content/Moryx.Launcher/main.js" type="module"></script>

<script>
    @{
        var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
        jsonOptions.Converters.Add(new JsonStringEnumConverter());
    }
    const el = document.getElementById('launcher');

    const webModuleItems = @Html.Raw(JsonSerializer.Serialize(webModuleItems, jsonOptions));
    el.webModuleItems = webModuleItems;

    const externalModuleItems = @Html.Raw(JsonSerializer.Serialize(externalModuleItems, jsonOptions));
    el.externalModuleItems = externalModuleItems;
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
