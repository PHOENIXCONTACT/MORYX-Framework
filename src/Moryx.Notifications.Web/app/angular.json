{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "notifications": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/notifications",
      "sourceRoot": "projects/notifications/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "../wwwroot/notifications",
              "browser": ""
            },
            "tsConfig": "projects/notifications/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/notifications/public"
              }
            ],
            "styles": [
              "@fontsource/roboto/latin-300.css",
              "@fontsource/roboto/latin-400.css",
              "@fontsource/roboto/latin-500.css",
              "@fontsource/roboto/latin-700.css",
              "@fontsource/roboto/latin-ext-300.css",
              "@fontsource/roboto/latin-ext-400.css",
              "@fontsource/roboto/latin-ext-500.css",
              "@fontsource/roboto/latin-ext-700.css",
              "material-symbols/outlined.css",
              "node_modules/@moryx/ngx-web-framework/styles/theme.scss",
              "projects/notifications/src/styles.scss"
            ],
            "scripts": [],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "4mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/notifications/src/environments/environment.ts",
                  "with": "projects/notifications/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "none",
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "notifications:build:production"
            },
            "development": {
              "buildTarget": "notifications:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    },
    "notifications-bar": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/notifications-bar",
      "sourceRoot": "projects/notifications-bar/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "../wwwroot/notifications-bar",
              "browser": ""
            },
            "tsConfig": "projects/notifications-bar/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/notifications-bar/public"
              }
            ],
            "styles": [
              "@fontsource/roboto/latin-300.css",
              "@fontsource/roboto/latin-400.css",
              "@fontsource/roboto/latin-500.css",
              "@fontsource/roboto/latin-700.css",
              "@fontsource/roboto/latin-ext-300.css",
              "@fontsource/roboto/latin-ext-400.css",
              "@fontsource/roboto/latin-ext-500.css",
              "@fontsource/roboto/latin-ext-700.css",
              "material-symbols/outlined.css",
              "node_modules/@moryx/ngx-web-framework/styles/theme.scss",
              "projects/notifications-bar/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "4mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                }
              ],
              "outputHashing": "none",
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "notifications-bar:build:production"
            },
            "development": {
              "buildTarget": "notifications-bar:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
