{
  "profiles": {
    "StartProject.Asp": {
        "commandName": "Project",
        "dotnetRunMessages": true,
        "launchBrowser": true,
        "applicationUrl": "https://localhost:5001",
        "environmentVariables": {
            "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "StartProject.Asp - Path Base test": {
          "commandName": "Project",
          "dotnetRunMessages": true,
          "launchBrowser": true,
          "useSSL": true,
          "applicationUrl": "https://localhost:5000/",
          "launchUrl": "https://localhost:5000/test",
          "environmentVariables": {
              "ASPNETCORE_ENVIRONMENT": "PathBase"
        }
    },
    "Debug ApiSpecGeneration": {
      "commandName": "Project",
      "commandLineArgs": "--output ..\\..\\schemas --openapi-version OpenApi3_1 --file-name framework-api",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "OpenApiBuildTime"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:5001"
    }
  }
}
